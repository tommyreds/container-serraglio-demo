# Caddy davanti al sito: HTTPS automatico (Let's Encrypt), compressione,
# HSTS e registro delle richieste con IP accorciato. Il registro ruota ogni
# giorno e i file più vecchi di 7 giorni vengono cancellati (logrotate).
# {$DOMINIO} viene sostituito da setup.sh.

{$DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy 127.0.0.1:3000

	log {
		# la rotazione la fa logrotate ogni giorno (deploy/logrotate): 7 giorni e poi via
		output file /var/log/caddy/serraglio.log {
			roll_disabled
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>Cookie delete
			request>headers>X-Forwarded-For delete
		}
	}
}

www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}
