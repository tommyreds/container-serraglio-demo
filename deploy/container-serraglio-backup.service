[Unit]
Description=Container Serraglio — copia di sicurezza giornaliera

[Service]
Type=oneshot
User=serraglio
Group=serraglio
ExecStart=/bin/bash /srv/container-serraglio/app/deploy/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# anche dati/: sqlite3 .backup su un database WAL deve poter aprire il file -shm
ReadWritePaths=/srv/container-serraglio/backup /srv/container-serraglio/dati
