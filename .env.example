# Copia in .env e adatta. npm start e npm run seed lo leggono da soli.

# PIN del pannello alla prima preparazione del database (sei cifre, non banale).
# Se lo lasci vuoto, npm run seed ne sceglie uno casuale e lo stampa.
ADMIN_PIN=

PORT=3000
# 127.0.0.1 = solo da questo computer. 0.0.0.0 = anche dalla rete locale (hotspot).
HOST=127.0.0.1
DB_PATH=./dati/container.db
FOTO_DIR=./dati/foto

# In produzione (VPS): NODE_ENV=production e l'indirizzo pubblico in https
NODE_ENV=development
BASE_URL=
